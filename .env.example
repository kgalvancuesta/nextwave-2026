HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./nextwave.sqlite
CONTROL_API_TOKEN=replace-with-a-long-random-token

# OpenAI Realtime/SIP
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin
OPENAI_SIP_URI=sip:proj_REPLACE_ME@sip.api.openai.com;transport=tls

# Generic outbound dialer contract: POST JSON, Authorization: Bearer <token>.
TELEPHONY_OUTBOUND_URL=
TELEPHONY_OUTBOUND_TOKEN=

# Generic SMS/email recap contract: POST JSON, Authorization: Bearer <token>.
RECAP_DELIVERY_URL=
RECAP_DELIVERY_TOKEN=

# SIP/tel URI used for a live REFER when policy requires human takeover.
HUMAN_ESCALATION_URI=tel:+12025550127
