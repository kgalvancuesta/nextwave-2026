DATABASE_PATH=./data/marketline.db

# Protects the dashboard and call-control APIs when accessed through the public tunnel.
DASHBOARD_USERNAME=marketline
DASHBOARD_PASSWORD=

# Preferred for an uploaded/local Markdown credential file. Keep it under secrets/.
TWILIO_CREDENTIALS_FILE=./secrets/twilio.md

# Optional environment overrides. These take precedence over the Markdown file.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=

# Externally reachable HTTPS origin, without a trailing slash.
# Live/demo calls require a stable hostname. Ephemeral trycloudflare.com URLs
# are rejected by the readiness gate.
PUBLIC_BASE_URL=https://marketline.example.com

# Must match the endpoint configured in OpenAI Platform > Project > Webhooks.
OPENAI_WEBHOOK_URL=https://marketline.example.com/api/webhooks/openai

# Named Cloudflare tunnel credential. Prefer the gitignored credentials file.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=./secrets/cloudflare-tunnel-credentials.json
# CLOUDFLARE_TUNNEL_TOKEN=

# Signature checks require TWILIO_AUTH_TOKEN. API keys authenticate REST calls but
# cannot validate webhook signatures. false is accepted only outside production.
TWILIO_VALIDATE_SIGNATURES=true

# Call recording. The greeting discloses recording when enabled. Required for
# offer audio evidence: with this off, a recorded fact keeps the carrier's
# verbatim statement and its position in the call, but there is no audio to play.
RECORD_CALLS=false

# Time zone the written commitment recap is rendered in. The zone is always
# named in the message so a disputed timestamp is never ambiguous.
RECAP_TIME_ZONE=America/Mexico_City

# How long carrier discovery runs before an unanswered lane stops holding the
# market. Defaults to 5 minutes; raise it for a live demo where the market is
# explained while the calls are still open. Capped at 120.
PROCUREMENT_DEADLINE_MINUTES=5

# OpenAI Realtime voice agent. OPENAI_CREDENTIALS_FILE may contain an API key,
# project ID, and webhook secret as labeled values or one value per line. The SIP
# URI is derived from the project ID unless OPENAI_SIP_URI overrides it.
OPENAI_CREDENTIALS_FILE=
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
OPENAI_SIP_URI=sip:proj_REPLACE_ME@sip.api.openai.com;transport=tls
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin

# SIP or tel URI the agent transfers to when policy requires a human.
# Optional. Without it -- or if the transfer itself fails -- the escalation is
# still recorded and the lane is paused, and the agent promises a callback and
# ends the call rather than leaving the counterparty on an open line.
HUMAN_ESCALATION_URI=tel:+12025550127
